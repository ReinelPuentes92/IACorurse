# ============================================================
# VARIABLES DE ENTORNO - Agentes IA con LangChain v1.0
# Autor: Ing. Kevin Inofuente Colque - DataPath
# ============================================================
#
# CÓMO USARLO:
#   1) cp .env.example .env
#   2) Rellena SOLO las variables del agente que vas a ejecutar
#   3) NUNCA subas tu archivo .env a GitHub (solo este .env.example)
#
# QUÉ NECESITA CADA AGENTE:
#   Agente A (básico) ............ OPENAI_API_KEY
#   Agente B (+ histórico) ....... OPENAI_API_KEY + DB_*
#   Agente C (+ base conocim.) ... OPENAI_API_KEY + DB_* + SUPABASE_*
#   Agente D (+ tool externa) .... todo lo anterior + TAVILY_API_KEY + AGENT_TIMEZONE
#   main_chatwoot_ia_off.py ...... todo lo anterior + CHATWOOT_*
# ============================================================


# ------------------------------------------------------------
# 1. OPENAI  (obligatorio para TODOS los agentes: A, B, C, D)
#    API key: https://platform.openai.com/api-keys
#    Se usa para el modelo de chat y para los embeddings del RAG
#    (text-embedding-ada-002).
# ------------------------------------------------------------
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ------------------------------------------------------------
# 2. POSTGRESQL / SUPABASE  (Agentes B, C, D)
#    Guarda el histórico de conversación (PostgresChatMessageHistory).
#    Dónde obtenerlo:
#      supabase.com/dashboard → tu proyecto
#      → Connect → Connection string → Transaction pooler
#    Ojo: DB_USER incluye tu project_ref después del punto.
# ------------------------------------------------------------
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_password_de_supabase
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres


# ------------------------------------------------------------
# 3. BASE DE CONOCIMIENTO / RAG  (Agentes C, D)
#    Dónde obtenerlo:
#      supabase.com/dashboard → tu proyecto
#      → Project Settings → API Keys
#        SUPABASE_URL          = Project URL
#        SUPABASE_SERVICE_KEY  = service_role (NO la anon key)
#    ⚠️ La service_role key salta el RLS: nunca la expongas en frontend.
# ------------------------------------------------------------
SUPABASE_URL=https://tu_project_ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXXXXXXXXXXXXXX


# ------------------------------------------------------------
# 4. TAVILY - Búsqueda en internet  (Agente D)
#    API key gratuita (1000 créditos/mes): https://app.tavily.com/
# ------------------------------------------------------------
TAVILY_API_KEY=tvly-dev-XXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ------------------------------------------------------------
# 5. ZONA HORARIA del agente - formato IANA  (tool Hora_y_fecha)
#    Ejemplos: America/Lima, America/Mexico_City,
#              America/Bogota, America/Santiago, Europe/Madrid
# ------------------------------------------------------------
AGENT_TIMEZONE=America/Lima


# ------------------------------------------------------------
# 6. CHATWOOT - Integración con el frontend  (main_chatwoot_ia_off.py)
#    Token: Chatwoot → Perfil → Profile Settings → Access Token
#    CHATWOOT_BASE_URL va SIN barra final.
# ------------------------------------------------------------
CHATWOOT_BASE_URL=https://tu-instancia-chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# Etiqueta (label) de la conversación que controla al agente en Chatwoot.
# Debe existir creada en Chatwoot con ese mismo nombre.
#   atiende-ia → el agente responde automáticamente
#   ia-off     → el agente NO responde (atiende un humano)
# Si no defines esta variable, el código usa "atiende-ia" por defecto.
CHATWOOT_BOT_LABEL=atiende-ia
