# ============================================================
# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env y completa con tus credenciales:
#   cp .env.example .env
# ============================================================

# OpenAI - Necesario para todos los agentes (A, B, C, D)
# Obtén tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Agente B: PostgreSQL para Histórico de Conversación (Supabase)
# Crea un proyecto en: https://supabase.com/dashboard
# Settings → Database → Connection string → Transaction pooler
# ------------------------------------------------------------
DB_USER=postgres.tu_project_ref
DB_PASSWORD=tu_password_de_supabase
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres

# ------------------------------------------------------------
# Agente C: Base de Conocimiento (RAG con Supabase + pgvector)
# Project Settings → API → service_role key
# ------------------------------------------------------------
SUPABASE_URL=https://tu_project_ref.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Agente D: Búsqueda en Internet (Tavily)
# Obtén tu API key en: https://app.tavily.com/
# ------------------------------------------------------------
TAVILY_API_KEY=tvly-dev-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# Frontend: Integración con Chatwoot
# Panel Chatwoot → Profile Settings → Access Token
# ------------------------------------------------------------
CHATWOOT_BASE_URL=https://tu-instancia-chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# Etiqueta que activa al agente IA en Chatwoot
# - "atiende-ia" → el agente responde
# - "ia-off"     → el agente NO responde
CHATWOOT_BOT_LABEL=ia-off

# ------------------------------------------------------------
# Zona horaria del agente (formato IANA)
# Ej: America/Lima, America/Mexico_City, America/Bogota, Europe/Madrid
# ------------------------------------------------------------
AGENT_TIMEZONE=America/Lima
