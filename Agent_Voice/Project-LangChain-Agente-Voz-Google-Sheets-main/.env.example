# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
#
# El .env está en .gitignore: nunca lo subas al repositorio.


# ============================================================
# OpenAI  (obligatorio)
# ============================================================
# Se usa para el LLM del agente y para el TTS (modelo tts-1).
# Consíguela en https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# ============================================================
# PostgreSQL / Supabase  (histórico de conversación)
# ============================================================
# Guarda dos cosas: los checkpoints de LangGraph (la memoria del agente)
# y la tabla voice_chat_log (auditoría legible con SQL).
#
# Si dejas estas variables vacías el agente NO se cae: usa memoria RAM y
# avisa por consola. Recuerda dentro de la sesión, pero no persiste.
#
# En Supabase: Project Settings > Database > Connection string > Session pooler
DB_USER=postgres.xxxxxxxxxxxxxxxx
DB_PASSWORD=
DB_HOST=aws-0-<region>.pooler.supabase.com

# IMPORTANTE: usa 5432 (pooler en modo "session").
# El 6543 es el modo "transaction", que no soporta prepared statements y
# hace fallar al checkpointer de LangGraph con DuplicatePreparedStatement.
DB_PORT=5432
DB_NAME=postgres


# ============================================================
# Sesión  (opcional)
# ============================================================
# Al arrancar, el programa imprime un Session ID. Si lo pones aquí (o lo
# pasas en la línea de comandos) retomas esa conversación en vez de
# empezar una nueva:
#
#   VOICE_SESSION_ID=<uuid> python talking_llm_part_3_completo_con_agente.py
#
# VOICE_SESSION_ID=
